# Copy to .env. `dotenvy` loads it in development; in production these are real
# environment variables and the missing file is a no-op.
# `APP__` prefix, `__` between every level: APP__DATABASE__URL -> settings.database.url

# Host port for the compose Postgres; change it when 5432 is taken, and keep the
# two URLs below in step with it.
POSTGRES_PORT=5432

APP__DATABASE__URL=postgres://postgres:postgres@localhost:5432/app
APP__DATABASE__MAX_CONNECTIONS=10
# The same URL again: sea-orm-cli (`make migrate`, `make entity`) reads this one.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=8000
# Comma-separated. Empty (the default) means no CORS layer at all: same-origin only.
APP__SERVER__CORS_ORIGINS=

APP__AUTH__JWT_SECRET=dev-only-change-me

# false prints human-readable logs; true emits one JSON object per line.
APP__TELEMETRY__JSON_LOGS=false
# Unset means no OTLP exporter at all, which is what you want locally.
# APP__TELEMETRY__OTLP_ENDPOINT=http://localhost:4317

# The otel::tracing directive is added by the app regardless; listed here so a
# copied value into another tool keeps the HTTP span.
RUST_LOG=info,app=debug,otel::tracing=trace

# Point the tests at an already-running Postgres. Without it they start a
# container themselves.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
